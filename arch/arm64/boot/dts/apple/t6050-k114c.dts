// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * MacBook Pro (14-inch PROLED XDR, M5 Max, 2026)
 *
 * target-type: K114c (Mac17,11)
 *
 * Preliminary: described from the ADT only, not yet booted on the hardware.
 *
 * Copyright The Asahi Linux Contributors
 */

#include "t6050-k114-k116.dtsi"

/ {
	compatible = "apple,k114c", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch PROLED XDR, M5 Max, 2026)";
};

&mtp_multitouch {
	firmware-name = "apple/tpmtfw-k114c.bin";
};

#define T6050_K114C
#include "t6050-peripherals.dtsi"

/ {
	aliases {
		/* kboot fills the N1's factory addresses from /chosen through these */
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
	};
};

/*
 * PCIe port 0: the N1 (Wi-Fi and Bluetooth), laid out as on J716c: the boot
 * loader trains the link and keeps power, clocks, the PHY and PERST; Linux owns
 * the routing, MSI and the DART. The port stays disabled until the loader
 * trains it.
 */
&pcie0 {
	reg = <0x1c 0xb0000000 0x0 0x10000000>,
	      <0x4 0x14000000 0x0 0x4000>,
	      <0x4 0x10028000 0x0 0x8000>,
	      <0x4 0x17010000 0x0 0x4000>,
	      <0x4 0x10024000 0x0 0x4000>,
	      <0x4 0x11028000 0x0 0x8000>,
	      <0x4 0x17014000 0x0 0x4000>,
	      <0x4 0x11024000 0x0 0x4000>,
	      <0x4 0x17020000 0x0 0x4000>;
	reg-names = "config", "rc", "port0", "phy0", "intr2axi0", "port1", "phy1", "intr2axi1",
		    "phy-shared";
	interrupts = <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 0 1531 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "port0", "port1";

	/* The N1's three functions are on DART streams 1-3 */
	iommu-map = <0x100 &dart_apcie0 1 3>,
		    <0x200 &dart_apcie1 1 1>;
	bus-range = <0 4>;
	/* dart_apcie1 probes only once port 1 is up: the host must not wait for it */
	post-init-providers = <&dart_apcie1>;
	status = "okay";

	port00: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0 0 0 0>;
		bus-range = <1 1>;
		apple,link-trained-by-bootloader;
		/* PERST#, driven only by the root-port reset after the N1's ROM stage */
		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
		status = "disabled";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
				<0 0 0 2 &port00 0 0 0 1>,
				<0 0 0 3 &port00 0 0 0 2>,
				<0 0 0 4 &port00 0 0 0 3>;

		/* platform ID (board 0x04 << 16) | chip 0x6050 */
		n1_control: control@0,0 {
			compatible = "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			firmware-name = "apple/centauri/k114c-ftab.bin";
			apple,centauri-platform-id = <0x00046050>;
			apple,centauri-protocol = <27>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			local-bd-address = [00 00 00 00 00 00];
		};
	};

	/*
	 * PCIe port 1: the SD card reader (ADT pci-bridge1/pcie-sdreader, a GL9755), as on
	 * J714s. The boot loader leaves it down, so the kernel trains it: power is the SMC
	 * pcIO output of function-sd_pwr_en (index 3 below), PERST# GPIO 81, IRQ 1531. It is
	 * on stream 1 of dart-apcie1. The link tunables are pci-bridge1's, as on port 0.
	 */
	port01: pci@1,0 {
		device_type = "pci";
		reg = <0x800 0 0 0 0>;
		bus-range = <2 2>;
		apple,link-trained-by-bootloader;
		pwren-gpios = <&smc_pcio 3 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl_ap 81 GPIO_ACTIVE_LOW>;
		apple,apcie-config-tunables = <0x140 4 0x1 0x1>,
			<0x144 4 0xffffff 0x253770>,
			<0x8a8 4 0x1 0x1>,
			<0x8ac 4 0x1 0x1>;
		apple,pcie-rc-tunables = <0x78 4 0x7000 0x0>,
			<0x194 4 0x2 0x2>,
			<0xb80 4 0x7f3f3f 0x7f1e1e>,
			<0xb88 4 0x7f3f3f 0x7f1e1e>;
		apple,pcie-rc-gen3-shadow-tunables = <0x154 4 0xf0f0f0f 0x5050505>,
			<0x890 4 0x3000000 0x0>,
			<0x8a8 4 0xffff0f 0x1>;
		apple,pcie-rc-gen4-shadow-tunables = <0x178 4 0xffff 0x5555>,
			<0x890 4 0x3000000 0x1000000>,
			<0x8a8 4 0xffff0f 0x1>;
		apple,pcie-rc-gen5-shadow-tunables = <0x1ac 4 0xffff 0x5555>,
			<0x890 4 0x3000000 0x2000000>,
			<0x8a8 4 0xffff0f 0x1>;

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port01 0 0 0 0>,
				<0 0 0 2 &port01 0 0 0 1>,
				<0 0 0 3 &port01 0 0 0 2>,
				<0 0 0 4 &port01 0 0 0 3>;

		/* The GL9755; card detect and write protect active high (ADT *-polarity = 1) */
		sdhci0: mmc@0,0 {
			compatible = "pci17a0,9755";
			reg = <0x20000 0x0 0x0 0x0 0x0>;
			cd-inverted;
			wp-inverted;
		};
	};
};

/*
 * Pin 112's register takes an SError when read, so only the pins a node here
 * names are exposed: 80 and 81 (PCIe ports 0 and 1's PERST#); 106 and 107, the speaker
 * amps' interrupt and shutdown line; 134 and 139, the jack codec's interrupt and
 * reset; 136 and 137, the speaker ID; 138, the Touch ID sensor's data-ready line.
 */
&pinctrl_ap {
	gpio-reserved-ranges = <0 80>, <82 24>, <108 26>, <135 1>, <140 81>;
};

/* It answers only once port 1's root complex is up: pcie-apple then enables it */
&dart_apcie1 {
	apple,manual-availability;
	status = "okay";
};

/*
 * The board's pcIO outputs (t6050-k114-k116.dtsi lists indices 0 to 2), plus index 3,
 * sd_pwr_en pKW8('pcIO', 0x0, 0x190000): ADT pcie-sdreader function-sd_pwr_en.
 */
&smc_pcio {
	apple,output-commands = /bits/ 64 <0x001a000000000000 0x000f000000800000
					   0x011c000000010000 0x0019000000000000>;
};

#include "t6050-k114c-gpu.dtsi"
#include "t6050-k114c-isp.dtsi"

/*
 * Sound through the AOP, as on J813: its audio service runs the serializers, the
 * CS42L84 headphone jack on admac-base-ns TX2/RX2 and the six SN012776 speaker amps
 * on TX0, their voltage and current sense on RX0 (ADT iop-audio-controller).
 *
 * The amps (ADT /arm-io/i2c1/audio-speaker* and /arm-io/i2c3/audio-speaker*) share
 * one shutdown line, AP pin 107 (function-reset of the first), and one fault
 * interrupt, pin 106. The ADT's speaker-config gives amp N playback slot N, its
 * voltage sense in slot 4N and current sense in 4N+2, in the order of the first
 * amp's speakerN: left woofer 1, right woofer 1, left woofer 2, right woofer 2,
 * left tweeter, right tweeter. The firmware's speaker frame is 250 BCLKs of 12 MHz
 * (ADT audio-speaker stream), which the amps' ratio detection rejects.
 */
/ {
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&i2c1 {
	status = "okay";

	speaker_left_woof1: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <2>;
		ti,vmon-slot-no = <0>;
		ti,bclk-ratio = <250>;
	};

	speaker_left_woof2: codec@39 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x39>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <10>;
		ti,vmon-slot-no = <8>;
		ti,bclk-ratio = <250>;
	};

	speaker_left_tweet: codec@3a {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3a>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <18>;
		ti,vmon-slot-no = <16>;
		ti,bclk-ratio = <250>;
	};
};

/* The I2C power states have no described parent (SIO), as for i2c1 and i2c2 */
&ps_i2c3 {
	/delete-property/ power-domains;
	status = "okay";
};

&i2c3 {
	/* The ADT gives i2c1, i2c2 and i2c3 the same clock-ids (4) */
	clocks = <&clkref>;
	status = "okay";

	speaker_right_woof1: codec@3b {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3b>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <6>;
		ti,vmon-slot-no = <4>;
		ti,bclk-ratio = <250>;
	};

	speaker_right_woof2: codec@3c {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3c>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <14>;
		ti,vmon-slot-no = <12>;
		ti,bclk-ratio = <250>;
	};

	speaker_right_tweet: codec@3d {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3d>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <22>;
		ti,vmon-slot-no = <20>;
		ti,bclk-ratio = <250>;
	};
};

/*
 * The CS42L84 headphone codec (ADT /arm-io/i2c2/audio-codec-output): its reset line
 * is AP pin 139, driven high to run the codec, and its interrupt AP pin 134, level
 * low.
 */
&i2c2 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Jack";
	};
};

/ {
	sound {
		compatible = "apple,j714-macaudio", "apple,macaudio";
		model = "MacBook Pro K114";
		/* ADT audio-speaker function-speaker-id0 and -id1 */
		speaker-id-gpios = <&pinctrl_ap 136 GPIO_ACTIVE_HIGH>,
				   <&pinctrl_ap 137 GPIO_ACTIVE_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};

		dai-link@1 {
			reg = <1>;
			link-name = "Speaker";
			/*
			 * Codecs in ADT speaker-config order, so that macaudio gives them
			 * playback slots 0-5 as macOS does (left channels in slots 0, 2
			 * and 4, right in 1, 3 and 5). The idle masks are the ADT
			 * amp-tx-zd-config rows 0 and 1: left woofer 1 drives zeros in the
			 * right amps' sense slots, right woofer 1 in the left amps'.
			 */
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xfff0f0f0>;
			dai-tdm-idle-mode-1 = "zero";
			dai-tdm-slot-tx-idle-mask-1 = <0xff0f0f0f>;

			cpu {
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker_left_woof1>, <&speaker_right_woof1>,
					    <&speaker_left_woof2>, <&speaker_right_woof2>,
					    <&speaker_left_tweet>, <&speaker_right_tweet>;
			};
		};
	};
};

/* The AOP, booted through its setup port, with its sensor and audio services. */
&aop_mbox {
	status = "okay";
};

&aop_setup_mbox {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&aop {
	status = "okay";
};

/*
 * The microphone array: ADT audio-hp-mic, three microphones on leap-s RX0 through the
 * proxy ADMAC (Linux channel 1, as on J813), captured by the AOP audio service's own card.
 */
&admac_base_ns {
	status = "okay";
};

&admac_ec_proxy {
	status = "okay";
};

&aop_audio {
	apple,chassis-name = "K114";
	apple,machine-kind = "MacBook Pro";
	dmas = <&admac_base_ns 4>, <&admac_base_ns 5>,
	       <&admac_base_ns 0>, <&admac_base_ns 1>,
	       <&admac_ec_proxy 1>;
	dma-names = "cout", "cin", "spkr", "sense", "hpai";
};

/*
 * The touchscreen (kiwi). Its reset and supply are NUB GPIO pins 25 and 26 (ADT
 * function-reset and function-power), not the shared multi-touch AFE reset.
 * The NUB GPIO block is always on and keeps its interrupts. Level 1 asserts
 * the reset, as for the AFE one [INFERENCE].
 */
&pmgr0 {
	ps_nub_gpio: power-controller@88 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x88 4>;
		label = "nub_gpio";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		apple,always-on;
	};
};

&nub_gpio0 {
	power-domains = <&ps_nub_gpio>;
	gpio-controller;
	#gpio-cells = <2>;
	gpio-ranges = <&nub_gpio0 0 0 61>;
	apple,npins = <61>;
	status = "okay";
};

&kiwi {
	firmware-name = "apple/tpkiwifw-k114c.bin";
	apple,power-method = <2>;
	apple,reset-gpios = <&nub_gpio0 25 GPIO_ACTIVE_LOW>;
	apple,power-gpios = <&nub_gpio0 26 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

/*
 * The kiwi 24 MHz clock pad (NUB pin 22) and display_sync pad (AP pin 11) are pad
 * functions, not host GPIOs: function 1 on each.
 */
&pinctrl_ap {
	kiwi_dsync_pins: kiwi-dsync-pins {
		pinmux = <0x1000b>;	/* APPLE_PINMUX(11, 1) */
	};
};

&nub_gpio0 {
	kiwi_clk24_pins: kiwi-clk24-pins {
		pinmux = <0x10016>;	/* APPLE_PINMUX(22, 1) */
	};
};

&mtp_hid {
	pinctrl-0 = <&kiwi_clk24_pins>, <&kiwi_dsync_pins>;
	pinctrl-names = "default";
};

/*
 * ==== The left-front USB-C port (ATC1) ====
 *
 * ADT /arm-io/nub-spmi-a0/hpm1 (SN201202x, SPMI address 0xa, port-number 2, port-location
 * "left-front", acio-parent acio1), with atc-phy1, usb-drd1 and dart-usb1. The K114cAP ADT
 * has the same hpm0, hpm1, hpm5, atc-phy and usb-drd nodes as the J714cAP one, so this is the
 * J714c port block. The ATC1 template nodes of t6050-dieX.dtsi are enabled here; the boards
 * sharing t6050-k114-k116.dtsi keep them disabled. The port's USB4/Thunderbolt router
 * (/arm-io/acio1) and its DisplayPort routes are not described; the PHY runs in USB mode.
 *
 * The left-back port (ATC0, hpm0) is the boot link's debug port; the combo PHY driver
 * excludes it on purpose (apple,port-index 0).
 */
/ {
	aliases {
		atcphy1 = &atc1_phy;
	};
};

&nub_spmi_a0 {
	status = "okay";
	/* reg[1]: the generation 4 fault queue, which macOS empties when the controller starts */
	reg = <0x2 0x8a188000 0x0 0x4000>,
	      <0x2 0x8a184000 0x0 0x4000>;

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C Left Front";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					hpm1_hs: endpoint {
						remote-endpoint = <&usb_drd1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					hpm1_ss: endpoint {
						remote-endpoint = <&atc1_phy_ep>;
					};
				};
			};
		};
	};

	/*
	 * The MagSafe 3 port's PD controller (ADT hpm5, port-type 0x11). It has no USB data path,
	 * so it gets no connector node. Its ADT features-supported is <3>: no liquid detection.
	 */
	hpm5: usb-pd@8 {
		compatible = "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
		apple,no-liquid-detection;
	};
};

&atc1_phy_mbox {
	status = "okay";
};

&atc1_phy {
	status = "okay";

	port {
		atc1_phy_ep: endpoint {
			remote-endpoint = <&hpm1_ss>;
		};
	};
};

&usb_drd1 {
	status = "okay";

	port {
		usb_drd1_hs: endpoint {
			remote-endpoint = <&hpm1_hs>;
		};
	};
};

&usb_drd1_dart_0 {
	status = "okay";
};

&usb_drd1_dart_1 {
	status = "okay";
};

/*
 * ==== The right USB-C port (ATC2), USB only ====
 *
 * ADT /arm-io/nub-spmi-a1/hpm2 (SN201202x, SPMI address 0xc, port-location "right", acio-parent
 * acio2), with atc-phy2, usb-drd2 and dart-usb2. The HPM is on its own bus, nub-spmi-a1, and
 * nothing hands the port off, so the power domains, the PHY mailbox, the PHY, the DWC3 and its
 * DARTs are enabled outright, as t6050-max-atc2.dtsi does for the J714c and J716c (linux#1714).
 * The USB4/Thunderbolt router (acio2) and the DisplayPort route are not described.
 */
/ {
	aliases {
		atcphy2 = &atc2_phy;
	};
};

&ps_atc2_common {
	status = "okay";
};

&ps_atc2_usb_aon {
	status = "okay";
};

&ps_atc2_phymxwrap {
	status = "okay";
};

&ps_atc2_usb {
	status = "okay";
};

&atc2_phy_mbox {
	status = "okay";
};

&atc2_phy {
	status = "okay";

	port {
		atc2_phy_ep: endpoint {
			remote-endpoint = <&hpm2_ss>;
		};
	};
};

&usb_drd2 {
	status = "okay";

	port {
		usb_drd2_hs: endpoint {
			remote-endpoint = <&hpm2_hs>;
		};
	};
};

&usb_drd2_dart_0 {
	status = "okay";
};

&usb_drd2_dart_1 {
	status = "okay";
};

&nub_spmi_a1 {
	status = "okay";
	/* the driver polls the PD controllers and refuses an interrupt on this bus */
	/delete-property/ interrupts;

	hpm2: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C Right";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					hpm2_hs: endpoint {
						remote-endpoint = <&usb_drd2_hs>;
					};
				};

				port@1 {
					reg = <1>;
					hpm2_ss: endpoint {
						remote-endpoint = <&atc2_phy_ep>;
					};
				};
			};
		};
	};
};

/*
 * Touch ID (ADT spi2/mesa, as on J714s, linux#1587): the Mesa sensor (sensor-id 0x3356) at 8 MHz
 * on chip select 0, powered by NUB GPIO 21, data ready on AP GPIO 138. The controller's clock
 * (ADT clock-ids 451) is the 24 MHz reference. ps_nub_gpio and nub_gpio0 are enabled above.
 */
&ps_spi2 {
	status = "okay";
};

&spi2 {
	clocks = <&clkref>;
	status = "okay";

	mesa: fingerprint@0 {
		compatible = "apple,mesa-fingerprint";
		reg = <0>;
		spi-max-frequency = <8000000>;
		spi-cpol;
		spi-cs-setup-delay-ns = <20>;
		spi-cs-hold-delay-ns = <20>;
		enable-gpios = <&nub_gpio0 21 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <138 IRQ_TYPE_EDGE_RISING>;
		/* Per-device factory data from this Mac's own iBoot system container */
		firmware-name = "apple/mesacal-k114c.bin", "apple/msrk-k114c.bin";
	};
};
