// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple MacBook Pro (14-inch, M5 Max, 18 CPU cores, OLED)
 *
 * target-type: K114c
 *
 * Initial RAM boot resources measured on the K114c (ADT ioreg gather of
 * 2026-11-10). The loader supplies usable memory, CPU release addresses and
 * framebuffer geometry. Peripheral power domains come from t6050-pmgr.dtsi;
 * the framebuffer holds the display domain.
 *
 * Compared with Edi Moldovan's J714c this board file leaves out, with
 * reasons:
 * - the DCP display pipeline (his t6050-j714c-display.dtsi): the console
 *   runs on the simple framebuffer the loader fills, and the K114c's OLED
 *   panel and DCP firmware segment table have not been measured, so there
 *   is no K114c display dtsi to include;
 * - the GPU (gfx/gfx1 mbox, gpu): enabled here for the K114c GPU bring-up
 *   (Main 15:49 CST); the loader-side ADT validation (dt_set_gpu_g17) must
 *   pass on this machine or the boot firmware disables the nodes again;
 * - the PMP (t6050-pmp.dtsi and the pmp-tunables): the ADT carries pmp0
 *   (/arm-io/pmp0, asc at 0x284e00000, clock-gates 0x1b 0x1c = ps_pmp +
 *   ps_pms_sram); it is included here so the GPU power vote reaches the
 *   PMP firmware and the b2bd GPU fabric turns on;
 * - the camera and ISP (his t6050-j714c-isp.dtsi): no K114c camera values
 *   measured;
 * - audio (I2C amps and jack codec, the AOP, the sound card): out of scope
 *   for this bring-up and the K114c ADT amplifier layout is unmeasured.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

#include "t6050.dtsi"
#include "t6050-smc.dtsi"
#include "t6050-gpu.dtsi"
#include "t6050-pmp.dtsi"
#include "t6050-j714c-pmp-tunables.dtsi"

/* GPU bring-up (Main 15:49 CST): enable the GPU and its mailboxes. The
 * UAT reserved-memory nodes are defined in t6050-gpu.dtsi with zero
 * addresses; the loader (dt_set_gpu_g17) fills them from the ADT at
 * boot. If it does not, the driver logs "failed to reserve memory for
 * node uat-*" and the GPU stays down. */
&gfx_mbox {
	status = "okay";
};

&gfx1_mbox {
	status = "okay";
};

&gpu {
	status = "okay";
};

/* PMP bring-up (ADT /arm-io/pmp0 clock-gates 0x1b 0x1c): the PMP
 * coprocessor owns the b2bd GPU fabric plane and drops direct CPU
 * writes to those ps registers. The GPU vote goes through the
 * pmp_report_gfx entry (reg 0xf = soc-device 0x10) that t6050-pmp.dtsi
 * hangs behind ps_gfx on the gpu node; these two gates power the PMP
 * ASC and its SRAM. The node stays status="disabled": pmp-report.c
 * (starts_pmp on T6050) takes the start over from the disabled node. */
&pmp {
	power-domains = <&ps_pmp>, <&ps_pms_sram>;
};

/* The ANE's vote (soc-device 0x11, Main 23:35 CST): gate 664 ANE_SYS_V is
 * notify_pmp like the GPU's b2bd planes, so the ANE votes through the PMP
 * report entry behind ps_ane_sys. Consumers attach with
 * power-domains = <&pmp_report_ane> on their node. */
&pmp_report {
	pmp_report_ane: report@10 {
		compatible = "apple,t6050-pmp-v2-report-entry",
			     "apple,t6000-pmp-v2-report-entry";
		reg = <0x10>;
		label = "pmp-ane";
		#power-domain-cells = <0>;
		power-domains = <&ps_ane_sys>;
	};
};

/ {
	compatible = "apple,k114c", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch, M5 Max, 18 CPU cores, OLED)";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&aic>;

	aliases {
		keyboard = &keyboard;
		serial0 = &serial0;
		/* kboot fills the N1's factory addresses from /chosen through these */
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:1500000n8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* Filled by the loader. */
			status = "okay"; /* m1n1 only enables it on chips it knows. */
			power-domains = <&ps_disp_cpu>;
			apple,internal-panel; /* simpledrm reports it as eDP */
		};
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0 0 0>; /* Filled by the loader. */
	};

	led-controller {
		compatible = "pwm-leds";
		led-0 {
			pwms = <&fpwm0 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

&fpwm0 {
	status = "okay";
};

&mtp {
	status = "okay";
};

/* The AP GPIO controller: the N1's PERST# is GPIO 80 on it, so pcie-apple defers until it binds. */
&pinctrl_ap {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	/*
	 * ADT multi-touch function-afe-reset = smc-pmu pKW8('pcIO', 0x10000,
	 * 0x11c0000), SMC pcIO output 28; level 1 asserts the reset. Left to
	 * the MTP firmware, the AFE sometimes never answers ("No HINT_L").
	 */
	apple,afe-reset-gpios = <&smc_gpio 28 GPIO_ACTIVE_HIGH>;

	mtp_mt: multi-touch {
		firmware-name = "apple/tpmtfw-k114c.bin";
		apple,power-method = <2>;
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};

	actuator {
	};

	tp_accel {
	};
};

#include "hwmon-common.dtsi"
#include "hwmon-fan-dual.dtsi"
#include "hwmon-laptop.dtsi"

/*
 * The T6050 SMC spells the fan mode keys F0md/F1md; F0Md/F1Md from
 * hwmon-fan*.dtsi do not exist (as on the J714c).
 */
&smc_hwmon {
	fan-F0Ac {
		apple,fan-mode = "F0md";
	};

	fan-F1Ac {
		apple,fan-mode = "F1md";
	};
};


#include "t6050-k114c-usb2.dtsi"
/*
 * iBoot leaves the N1 port's gates in automatic power management with the
 * target on and the block gated (APCIE_SYS_GP and APHY_GP_AUS5 actual 0,
 * APCIE_PHY_SW actual 4). The kernel trains the port, so these gates stay
 * at the requested state.
 */
&ps_apcie_sys_gp {
	apple,no-auto-pm;
};

&ps_apcie_phy_sw {
	apple,no-auto-pm;
};

&ps_aphy_gp_aus5 {
	apple,no-auto-pm;
};

/*
 * The N1 (Wi-Fi and Bluetooth) on apcie0 port 0, the same port, registers
 * and pins as the J714c (K114c ADT 2026-11-10: pci-bridge0 function-perst =
 * GPIO 80, function-reset = pKW4('gP13', ...), so SMC GPIO 19; dart-apcie0
 * AIC 1524; apcie0 port0 AIC 1523; msi-vector-offset 1824 with pci-bridge0
 * owning 32 vectors; root board-id 0x04). iBoot leaves the port untrained
 * and the N1 off (SMC GPIO gP13 low, PERST# GPIO 80 low); the kernel trains
 * it (apple_pcie_t6050_cold_train, entered when adopt finds the link down
 * and the port names pwren-gpios; apple,link-trained-by-bootloader is the
 * adopt path's port-validity flag, not a claim about who trained it).
 * Platform id = (board-id 0x04 << 16) | 0x6050 by the J714c/J716c rule; the
 * FTAB comes from the macOS install and is not shipped by anyone.
 */
&pcie0 {
	reg = <0x1c 0xb0000000 0x0 0x10000000>,		/* ADT reg[0] */
	      <0x4 0x14000000 0x0 0x4000>,		/* ADT reg[1] */
	      <0x4 0x10028000 0x0 0x8000>,		/* ADT reg[16] */
	      <0x4 0x17010000 0x0 0x4000>,		/* ADT reg[18] */
	      <0x4 0x10024000 0x0 0x4000>,		/* ADT reg[19] */
	      <0x4 0x17020000 0x0 0x4000>,		/* ADT reg[3] */
	      <0x4 0x17004000 0x0 0x4000>,		/* phy-common: ADT reg[2] + 0x4000 */
	      <0x4 0x16000000 0x0 0x1000000>,		/* ADT reg[5]: K114c size */
	      <0x4 0x15044000 0x0 0x4000>,		/* ADT reg[6] */
	      <0x4 0x17000000 0x0 0x800000>,		/* ADT reg[2]: K114c size */
	      <0x4 0x17800000 0x0 0x1b4000>;		/* ADT reg[4] */
	reg-names = "config", "rc", "port0", "phy0", "intr2axi0", "phy-shared", "phy-common",
		    "axi2af", "pcieclkgen", "phy-window", "phy-ip";
	interrupts = <AIC_IRQ 1523 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "port0";

	/* The N1's three functions are on DART streams 1-3 */
	iommu-map = <0x100 &dart_apcie0 1 3>;
	bus-range = <0 8>; /* ADT bus-range 0x0,0x8 (the J714c's says 0-4) */

	port00: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0 0 0 0>;
		bus-range = <1 1>;
		apple,link-trained-by-bootloader;
		/* PERST#, for the kernel's train and the root-port reset after the N1's ROM stage */
		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
		/* The N1's power/reset: ADT function-reset = pKW4('gP13', ...), SMC GPIO pin 0x13 */
		pwren-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
		status = "okay";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
				<0 0 0 2 &port00 0 0 0 1>,
				<0 0 0 3 &port00 0 0 0 2>,
				<0 0 0 4 &port00 0 0 0 3>;

		n1_control: control@0,0 {
			compatible = "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			firmware-name = "apple/centauri/k114c-ftab.bin";
			apple,centauri-platform-id = <0x00046050>;
			apple,centauri-protocol = <27>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

&dart_apcie0 {
	status = "okay";
};

#include "t6050-j714c-pcie-tunables.dtsi"
#include "t6050-k114c-pcie-tunables.dtsi"
